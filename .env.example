# Names only. Copy the values into the files named below; never commit them.

# backend/.env (doc: `export GOOGLE_API_KEY=...`; start-all.sh passes it with --env-file)
GOOGLE_API_KEY=<your key>

# my-copilot-app/.env.intelligence (Threads pages: the runtime's CopilotKitIntelligence)
CPK_INTELLIGENCE_API_KEY=
